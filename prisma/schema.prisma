generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  GUEST
  HOST
  ADMIN
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ReservationStatus {
  REVIEWING
  CONFIRMED
  PAYMENT_DUE
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CASH
  OTHER
}

enum ReviewStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

model User {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String        @unique
  name          String
  phone         String?
  role          UserRole      @default(GUEST)
  authUserId    String?       @unique @db.Uuid
  hostedProperties Property[] @relation("PropertyOwner")
  reservations  Reservation[] @relation("GuestReservations")
  reviews       Review[]      @relation("ReviewAuthor")
  payments      Payment[]     @relation("PaymentPayer")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([role])
}

model Property {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String          @db.Uuid
  owner        User            @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name         String
  slug         String          @unique
  description  String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  country      String
  postalCode   String?
  timezone     String          @default("America/Los_Angeles")
  bedrooms     Int             @default(1)
  bathrooms    Decimal         @default(1.0) @db.Decimal(3, 1)
  maxGuests    Int
  nightlyRate  Decimal         @db.Decimal(10, 2)
  cleaningFee  Decimal         @default(0) @db.Decimal(10, 2)
  currency     String          @default("USD") @db.Char(3)
  status       PropertyStatus  @default(DRAFT)
  reservations Reservation[]
  reviews      Review[]
  payments     Payment[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([city, country])
}

model Reservation {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId  String            @db.Uuid
  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  guestId     String            @db.Uuid
  guest       User              @relation("GuestReservations", fields: [guestId], references: [id], onDelete: Restrict)
  checkInDate DateTime          @db.Date
  checkOutDate DateTime         @db.Date
  guestCount  Int
  status      ReservationStatus @default(REVIEWING)
  totalAmount Decimal           @db.Decimal(10, 2)
  currency    String            @default("USD") @db.Char(3)
  notes       String?
  payments    Payment[]
  review      Review?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([propertyId, checkInDate, checkOutDate])
  @@index([guestId])
  @@index([status])
}

model Review {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId String       @unique @db.Uuid
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  propertyId    String       @db.Uuid
  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  authorId      String       @db.Uuid
  author        User         @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  rating        Int
  body          String
  hostReply     String?
  status        ReviewStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([propertyId])
  @@index([authorId])
  @@index([status])
}

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId     String        @db.Uuid
  reservation       Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  propertyId        String        @db.Uuid
  property          Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  payerId           String        @db.Uuid
  payer             User          @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Restrict)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("USD") @db.Char(3)
  status            PaymentStatus @default(PENDING)
  method            PaymentMethod @default(CARD)
  provider          String?
  providerPaymentId String?       @unique
  paidAt            DateTime?
  refundedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([reservationId])
  @@index([propertyId])
  @@index([payerId])
  @@index([status])
}
